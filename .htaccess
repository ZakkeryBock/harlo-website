# goharlo.com on Hostinger (LiteSpeed, Apache rules). The site is a static
# Next.js export: /pricing is pricing.html, and a folder named pricing/ beside
# it holds page data, not a page. Without these rules /pricing would hit that
# folder and answer 403.

Options -Indexes
DirectorySlash Off
DirectoryIndex index.html

RewriteEngine On

# No http->https redirect here: Cloudflare sits in front and may reach this
# server over plain http, so a redirect on %{HTTPS} would loop forever. Use
# Cloudflare's "Always Use HTTPS" instead.

# /pricing/ -> /pricing
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /pricing -> pricing.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build files never change; everything else revalidates.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
